{
  "name": "cliproxyapi-console",
  "version": "0.1.0",
  "description": "A self-contained web console that installs, runs and manages CLIProxyAPI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wynn-dev/cliproxyapi-console.git"
  },
  "homepage": "https://github.com/wynn-dev/cliproxyapi-console#readme",
  "keywords": [
    "cliproxyapi",
    "cli-proxy-api",
    "llm",
    "proxy",
    "console",
    "dashboard"
  ],
  "type": "module",
  "bin": {
    "cpa-console": "dist-server/cli.js"
  },
  "files": [
    "dist",
    "dist-server"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"NODE_ENV=development node --watch-path=server server/cli.ts --no-open\" \"vite\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/cli.js",
    "prepare": "npm run build",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.54.0",
    "oxlint": "^1.81.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
